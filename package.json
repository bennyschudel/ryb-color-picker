{
  "name": "ryb-color-picker",
  "description": "A RYB Color Picker Wheel implemented as a web component",
  "license": "MIT",
  "author": "Benny Schudel",
  "version": "0.5.0",
  "type": "module",
  "types": "dist/types/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.min.js",
      "types": "./dist/types/main.d.ts"
    },
    "./dist/ryb-color-picker": "./dist/main.min.js"
  },
  "files": [
    "API.md",
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p analyze build:src",
    "build:src": "vite build",
    "preview": "vite preview",
    "analyze": "cem analyze --litelement --outdir dist",
    "e2e": "npx playwright test",
    "e2e:report": "npx playwright show-report",
    "e2e:update": "npx playwright test --update-snapshots",
    "pages:deploy": "./tasks/build-and-deploy-pages.sh"
  },
  "peerDependencies": {
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "lit": "^3.2.1",
    "rybitten": "^0.22.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "npm-run-all": "^4.1.5",
    "vite": "^6.3.0",
    "vite-plugin-bundlesize": "^0.1.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-static-copy": "^2.3.1"
  },
  "customElements": "./dist/custom-elements.json"
}
